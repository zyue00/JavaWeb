<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gzu.javawebproject.mapper.CourseMapper">

    <!-- 查询所有课程 -->
    <select id="selectAll" resultType="com.gzu.javawebproject.entity.Course">
        SELECT * FROM course
    </select>

    <!-- 根据教师 ID 查询课程 -->
    <select id="selectByTeacherId" resultType="com.gzu.javawebproject.entity.Course">
        SELECT * FROM course WHERE teacher_id = #{teacherId}
    </select>

</mapper>
